<style>
  .author em {
    font-style: normal;
    font-weight: 700;
    text-decoration: none;
  }

  #{{ entry.key }} .equal-contribution-mark {
    vertical-align: super;
    font-size: 0.7em;
    line-height: 0;
  }

</style>

{% if entry.equal_contribution %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var author = document.querySelector("#{{ entry.key }} .author");
    if (!author) return;
    author.innerHTML = author.innerHTML
      .replace("Qingda Hu", "Qingda Hu<sup class=\"equal-contribution-mark\">†</sup>")
      .replace("Ziheng Qiu", "Ziheng Qiu<sup class=\"equal-contribution-mark\">†</sup>");
  });
</script>
{% endif %}
